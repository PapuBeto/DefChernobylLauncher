      "type": "shell",
      "command": "npm",
      "windows": { "command": "npm.cmd" },
      "args": ["run", "pack"],
      "problemMatcher": []
    },
    {
      "label": "npm: install",
      "detail": "Instala/actualiza dependencias",
      "type": "shell",
      "command": "npm",
      "windows": { "command": "npm.cmd" },
      "args": ["install"],
      "problemMatcher": []
    },
    {
      "label": "npm: icon",
      "detail": "Regenera build/icon.png e icon.ico",
      "type": "shell",
      "command": "npm",
      "windows": { "command": "npm.cmd" },
      "args": ["run", "icon"],
